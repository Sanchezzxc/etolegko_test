# Keitaro instance (without /admin and without trailing slash)
KEITARO_URL=https://tlgk.host
# Profile -> API keys in Keitaro admin
KEITARO_API_KEY=put-your-key-here

# Every campaign name gets this prefix (as required by the task)
CAMPAIGN_NAME_PREFIX=test_grimaylo_

# Values preselected in the "create campaign" form (matched by name)
DEFAULT_DOMAIN=kylovoa.com
DEFAULT_GROUP=FORTESTS
DEFAULT_TRAFFIC_SOURCE=FORTESTS

# Where the Google stream redirects
GOOGLE_URL=https://google.com

# SQLite by default; any SQLAlchemy URL works, e.g. postgresql+psycopg://user:pass@localhost/keitaro
DATABASE_URL=sqlite:///./keitaro_wrapper.db

# Timezone used for statistics reports
REPORT_TIMEZONE=Europe/Moscow
